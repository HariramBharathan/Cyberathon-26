# Development defaults are intentionally local. Generate a fresh secret before deployment.
SECRET_KEY=replace-with-at-least-32-random-characters
SENTINELPASS_ENV=development
DATABASE_URL=sqlite:///instance/sentinelpass.db
APP_BASE_URL=http://127.0.0.1:5000

# OTP and device lifetimes (seconds/days)
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
QR_TTL_SECONDS=120
TRUSTED_DEVICE_DAYS=30
SESSION_TTL_SECONDS=28800

# Explainable LIAE policy thresholds
RISK_LOW_MAX=24
RISK_MEDIUM_MAX=49

# Email: leave MAIL_SERVER empty for labeled local-console delivery in development.
# Development OTP defaults to 549213; production always generates random codes.
DEMO_OTP=549213
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=SentinelPass <no-reply@example.com>

# SMS_PROVIDER=demo prints a clearly labeled code to the development server console.
# For an HTTPS JSON webhook adapter, set SMS_PROVIDER=webhook plus both values below.
SMS_PROVIDER=demo
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Production: use a shared Redis rate-limit store and an explicit production database URL.
RATELIMIT_STORAGE_URI=memory://